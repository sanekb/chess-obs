{
  "fmt": {
    "newLineKind": "system"
  },
  "lock": false,
  "imports": {
    "@/": "./src/",
    "@oxi/schema": "jsr:@oxi/schema@^0.3.0",
    "clsx": "npm:clsx@^2.1.1",
    "hono": "jsr:@hono/hono@^4.12.23",
    "preact": "npm:preact@^10.29.2",
    "preact-render-to-string": "npm:preact-render-to-string@^6.7.0",
    "preact-signals": "npm:@preact/signals@^2.9.1",
    "preact-signals-core": "npm:@preact/signals-core@^1.14.2"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "checkJs": true,
    "noImplicitAny": false
  },
  "tasks": {
    "fmt": "deno fmt",
    "build:js": {
      "command": "deno bundle src/client/app.jsx -o public/app.js --minify --platform browser",
      "dependencies": ["fmt"]
    },
    "build:css": {
      "command": "tailwindcss -i ./src/client/app.css -o ./public/app.css",
      "dependencies": ["fmt"]
    },
    "dev": {
      "command": "deno run -A --env-file=.env src/server/app.js",
      "dependencies": ["build:js", "build:css"]
    },
    "run": "deno run -A --env-file=.env src/server/app.js"
  }
}
