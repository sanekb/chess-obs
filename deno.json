{
  "fmt": {
    "newLineKind": "system"
  },
  "lock": false,
  "imports": {
    "@/": "./src/",
    "better-fetch": "npm:@better-fetch/fetch@^1.3.1",
    "clsx": "npm:clsx@^2.1.1",
    "hono": "jsr:@hono/hono@^4.12.27",
    "logtape": "jsr:@logtape/logtape@^2.2.1",
    "preact": "npm:preact@^10.29.2",
    "preact-render-to-string": "npm:preact-render-to-string@^6.7.0",
    "preact-signals": "npm:@preact/signals@^2.9.2",
    "preact-signals-core": "npm:@preact/signals-core@^1.14.3",
    "tailwind-merge": "npm:tailwind-merge@^3.6.0",
    "valibot": "jsr:@valibot/valibot@^1.4.2"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "checkJs": true,
    "noImplicitAny": false
  },
  "tasks": {
    "fmt": "deno fmt",
    "build:js": {
      "command": "deno bundle src/client/app.jsx -o public/app.js --minify --platform browser",
      "dependencies": ["fmt"]
    },
    "build:css": {
      "command": "tailwindcss -i ./src/client/app.css -o ./public/app.css --minify",
      "dependencies": ["fmt"]
    },
    "dev": {
      "command": "deno run -A --env-file src/server/app.js",
      "dependencies": ["build:js", "build:css"]
    },
    "run": "deno run -A --env-file src/server/app.js"
  }
}
