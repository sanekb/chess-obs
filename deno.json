{
  "fmt": {
    "newLineKind": "lf"
  },
  "lock": false,
  "imports": {
    "@/": "./src/",
    "@std/async": "jsr:@std/async@^1.5.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/text": "jsr:@std/text@^1.0.19",
    "better-fetch": "npm:@better-fetch/fetch@^1.3.1",
    "clsx": "npm:clsx@^2.1.1",
    "hono": "jsr:@hono/hono@^4.13.5",
    "hono-valibot": "jsr:@hono/valibot-validator@^0.6.1",
    "logtape-hono": "jsr:@logtape/hono@^2.3.2",
    "logtape": "jsr:@logtape/logtape@^2.3.2",
    "preact": "npm:preact@^10.29.8",
    "preact-render-to-string": "npm:preact-render-to-string@^6.7.0",
    "preact-signals": "npm:@preact/signals@^2.11.1",
    "preact-signals-core": "npm:@preact/signals-core@^1.14.4",
    "tailwind-merge": "npm:tailwind-merge@^3.6.0",
    "temporal-polyfill": "npm:temporal-polyfill@^1.0.4",
    "valibot": "jsr:@valibot/valibot@^1.4.2"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "checkJs": true,
    "noImplicitAny": false
  },
  "tasks": {
    "fmt": "deno fmt",
    "build:js": {
      "command": "deno bundle src/client/app.jsx -o public/app.js --minify --platform browser",
      "dependencies": ["fmt"]
    },
    "build:css": {
      "command": "tailwindcss -i ./src/client/app.css -o ./public/app.css --minify",
      "dependencies": ["fmt"]
    },
    "dev": {
      "command": "deno run -A --env-file --unstable-cron src/server/app.js",
      "dependencies": ["build:js", "build:css"]
    },
    "run": "deno run -A --env-file --unstable-cron src/server/app.js"
  }
}
